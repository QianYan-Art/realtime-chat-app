# ============================================
# 本地开发环境配置
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ============================================

# 应用环境 (development / production)
DEVBOX_NODE_ENV=development

# 前端服务端口
DEVBOX_PORT=3000

# Spring Boot profile (dev / prod)
DEVBOX_SPRING_PROFILES_ACTIVE=dev

# JWT 签名密钥 - 生产环境必须使用 32 字节以上的随机字符串
# 生成命令: openssl rand -base64 48
DEVBOX_JWT_SECRET=change_me_in_production_use_random_32bytes

# 管理员账号
DEVBOX_ADMIN_USERNAME=admin
DEVBOX_ADMIN_PASSWORD=change_me_in_production

# 应用域名
DEVBOX_APP_DOMAIN=localhost

# 数据库配置 (H2 内存模式用于开发)
DEVBOX_DB_URL=jdbc:h2:file:./data/chatapp
DEVBOX_DB_USERNAME=sa
DEVBOX_DB_PASSWORD=

# CORS 允许的来源（逗号分隔多个域名）
DEVBOX_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 日志配置
DEVBOX_LOG_LEVEL=INFO
DEVBOX_LOG_PATH=./logs
