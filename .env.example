# Devbox应用配置
DEVBOX_NODE_ENV=production
DEVBOX_PORT=3000

# Devbox后端配置
DEVBOX_SPRING_PROFILES_ACTIVE=prod
DEVBOX_JWT_SECRET=your_jwt_secret_key_here

# Devbox管理员配置
DEVBOX_ADMIN_USERNAME=admin
DEVBOX_ADMIN_PASSWORD=your_admin_password_here

# Devbox域名配置
DEVBOX_APP_DOMAIN=your_app_domain_here

# Devbox数据库配置
DEVBOX_DB_URL=jdbc:mysql://prod-db:3306/appdb # 需配置真实数据库地址
DEVBOX_JWT_SECRET=prod_secure_key_here_32bytes # 需替换为32位以上随机字符串
DEVBOX_APP_DOMAIN=your-app-name.sealos.app # 需设置为Devbox分配的实际域名
DEVBOX_ALLOWED_ORIGINS=https://your-app-name.sealos.app # 需与域名完全匹配

# Devbox日志配置
DEVBOX_LOG_LEVEL=INFO
DEVBOX_LOG_PATH=/app/logs