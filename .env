# Devbox应用配置
DEVBOX_NODE_ENV=production
DEVBOX_PORT=3000

# Devbox后端配置
DEVBOX_SPRING_PROFILES_ACTIVE=prod
DEVBOX_JWT_SECRET=devbox_jwt_secret_key_change_in_production

# Devbox管理员配置
DEVBOX_ADMIN_USERNAME=admin
DEVBOX_ADMIN_PASSWORD=devbox_admin_password_change_in_production

# Devbox域名配置
DEVBOX_APP_DOMAIN=localhost

# Devbox数据库配置
DEVBOX_DB_URL=jdbc:h2:file:./data/chatapp
DEVBOX_DB_USERNAME=sa
DEVBOX_DB_PASSWORD=

# Devbox允许的跨域来源
DEVBOX_ALLOWED_ORIGINS=http://localhost:3000

# Devbox日志配置
DEVBOX_LOG_LEVEL=INFO
DEVBOX_LOG_PATH=./logs